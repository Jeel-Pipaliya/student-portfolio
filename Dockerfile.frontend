# Practical 11: Multi-Stage Build Dockerfile for React Frontend
# Supplementary Problem 2: Reduces final production image from ~1.1GB to ~25MB

# -----------------------------------------------------------------------------
# Stage 1: Build Stage (Node.js 18 Alpine)
# -----------------------------------------------------------------------------
FROM node:18-alpine AS builder

WORKDIR /app

# Copy dependency definitions
COPY package*.json ./

# Install dependencies (including devDependencies required for Vite build)
RUN npm install

# Copy source code and configuration files
COPY . .

# Build the optimized production bundle (outputs to /app/dist)
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 2: Production Serving Stage (Ultra-lightweight Nginx Alpine)
# -----------------------------------------------------------------------------
FROM nginx:alpine

# Remove default Nginx welcome page
RUN rm -rf /usr/share/nginx/html/*

# Copy built production assets from Stage 1 builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration supporting React Router SPA fallback and proxy
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose container HTTP port
EXPOSE 80

# Run Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
